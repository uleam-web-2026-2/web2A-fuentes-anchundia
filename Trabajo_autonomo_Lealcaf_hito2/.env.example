# Configuracion de PostgreSQL. Copiar como .env y completar solo localmente.
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=lealcaf_api
DB_PASSWORD=
DB_MIGRATION_USER=lealcaf_migrador
DB_MIGRATION_PASSWORD=
DB_NAME=fidelizacion_db
PORT=8080
# Para Go local use 127.0.0.1; Docker necesita vacío para escuchar en su interfaz.
BIND_HOST=
JWT_SECRET=
JWT_TTL=1h
DEMO_DATA=false
DEMO_CLIENT_PASSWORD=
DEMO_ADMIN_PASSWORD=
GIN_MODE=release
REPOSITORY_ADAPTER=sqlc
