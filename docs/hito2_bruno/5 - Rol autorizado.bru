meta {
  name: 5 · Administrador confirma → 200
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/canjes/{{canjeId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "confirmado"
  }
}

script:pre-request {
  const token = bru.getVar("tokenAdmin");
  if (!token) throw new Error("Ejecute antes la petición 0; y la 2 si renovará la sesión cliente.");
  req.setHeader("Authorization", "Bearer " + token);
  const canjeId = bru.getVar("canjeId");
  if (!canjeId) throw new Error("Ejecute la petición 0 antes de este ensayo.");
  req.setUrl(bru.getEnvVar("baseUrl").replace(/\/$/, "") + "/canjes/" + canjeId + "/estado");
}

assert {
  res.status: eq 200
}

tests {
  test("La confirmación cambia el canje nuevo", function () {
    expect(res.getBody().id).to.equal(Number(bru.getVar("canjeId")));
    expect(res.getBody().estado).to.equal("confirmado");
  });
}

docs {
  Consume el canje nuevo: no repetir sin volver a ejecutar 0. El saldo se descuenta al confirmar.
}
