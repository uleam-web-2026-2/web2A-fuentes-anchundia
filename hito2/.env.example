# Configuracion de PostgreSQL para el proyecto actual.
# Copie como .env y complete solo localmente; no versionar contrasena ni JWT_SECRET.
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fidelizacion_db
PORT=8080
JWT_SECRET=
JWT_TTL=1h
DEMO_DATA=true
GIN_MODE=release
